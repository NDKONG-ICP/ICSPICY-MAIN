type ICSpicy = 
 service {
   _initializeAccessControl: () -> () query;
   acceptOffer: (offerId: text) -> (Offer);
   addAdmin: (p: principal) -> ();
   addArtworkLayer: (name: text, object_key: text, layer_number: nat) ->
    (ArtworkLayer);
   addFeedingEntry: (plantId: PlantId, productName: text, nutrientType: 
    text, dosage: text, notes: opt text) -> (bool);
   addFeedingRecord: (input: AddFeedingInput) -> (FeedingPublic);
   addNimsPlantPhoto: (plantId: PlantId, url: text, caption: opt text) ->
    (bool);
   addPestEntry: (plantId: PlantId, pestName: text, severity: text,
    treatment: opt text, notes: opt text) -> (bool);
   addPlant: (varietyId: nat, stage: PlantStage, trayId: opt TrayId,
    cellPosition: opt nat, price: opt nat) -> (AddPlantResult);
   addPlantBatch: (varietyId: nat, stage: PlantStage, count: nat, trayId:
    opt TrayId) -> (vec AddPlantResult);
   addPlantNote: (plantId: PlantId, "text": text) -> (bool);
   addPlantPhoto: (plant_id: PlantId, photo_key: text) -> ();
   addPurchasedPlantToNims: (nftTokenId: nat, container: ContainerSize,
    locationNotes: opt text) -> (PlantSeedResult);
   addVariety: (name: text, species: text, scovilleMin: nat, scovilleMax:
    nat, description: text, imageUrl: opt text, daysToGerm: opt nat,
    daysToMature: opt nat) -> (nat);
   addWateringEntry: (plantId: PlantId, amountMl: nat, phLevel: opt float64,
    notes: opt text) -> (bool);
   addWeatherRecord: (input: AddWeatherRecordInput) -> (WeatherRecord);
   addWeatherSnapshot: (plantId: PlantId, snapshot: WeatherSnapshot) ->
    (bool);
   addZonePhoto: (tray_id: TrayId, photo_key: text) -> ();
   adminSubmitToDAB: (collectionName: text, collectionDescription: text,
    standard: text, canisterIdOverride: opt text) ->
    (variant {
       err: text;
       ok: text;
     });
   adminTransferFromPool: (tokenId: nat, to: Account) -> (TransferResult);
   adminUnstickOrder: (orderId: nat) ->
    (record {
       message: text;
       success: bool;
     });
   adminUnstickPepperHead: (tokenId: nat) ->
    (record {
       message: text;
       success: bool;
     });
   adminWithdrawTokens: (ledgerCanisterId: text, to: principal, amount:
    nat) -> (AdminWithdrawTokensResult);
   airdropNFT: (_token_id: text, _recipient: principal) -> ();
   assignCallerUserRole: (_user: principal, _role: UserRole) -> ();
   assignPoolNFT: (nftId: nat, action: AssignAction) -> ();
   batchAirdropFromPool: (assignments: vec AirdropAssignment) ->
    (record {
       failed: nat;
       succeeded: nat;
     });
   batchAssignPoolNFTs: (nftIds: vec nat, action: AssignAction) -> (nat);
   batchAssignToQR: (nftIds: vec nat) -> (vec QRAssignmentResult);
   batchFeed: (plantIds: vec PlantId, productName: text, nutrientType: 
    text, dosage: text, notes: opt text) -> (nat);
   batchListOnShop: (assignments: vec ShopAssignment) ->
    (record {
       failed: nat;
       succeeded: nat;
     });
   batchMintFoundersCollection: (_entries: vec FoundersMintInput) ->
    (vec FoundersMintResult);
   batchWater: (plantIds: vec PlantId, amountMl: nat, phLevel: opt float64,
    notes: opt text) -> (nat);
   beginArtworkUpload: (totalChunks: nat) -> ();
   bulkCreateProducts: (inputs: vec CreateProductInput) ->
    (vec BulkCreateResult);
   buyListedNft: (tokenId: nat, token: PaymentToken, amount: nat) ->
    (BuyListedNftResult);
   buyResaleListing: (listing_id: text) -> (variant {
                                              err: text;
                                              ok;
                                            });
   cancelOffer: (offerId: text) -> (Offer);
   cancelResaleListing: (listing_id: text) -> (variant {
                                                 err: text;
                                                 ok;
                                               });
   clearArtworkFiles: () -> ();
   confirmICPayPayment: (orderId: nat, paymentId: text) ->
    (record {
       message: text;
       success: bool;
     });
   confirmOrderPaymentDirect: (orderId: nat, ledgerCanisterId: text, amount:
    nat) -> (ConfirmOrderPaymentDirectResult);
   counterOffer: (input: CounterOfferInput) -> (Offer);
   createBatchGiftPack: (plant_ids: vec PlantId) ->
    (variant {
       err: text;
       ok: BatchGiftPackPublic;
     });
   createComment: (input: CreateCommentInput) -> (CommentPublic);
   createDAOProposal: (input: CreateProposalInput) -> (ProposalPublic);
   createNimsTray: (name: text, date: Timestamp, varietyId: opt nat) ->
    (TrayId);
   createOrder: (buyer: principal, input: CreateOrderInput) -> (OrderPublic);
   createPlant: (input: CreatePlantInput) -> (PlantPublic);
   createPost: (input: CreatePostInput) -> (PostPublic);
   createProduct: (input: CreateProductInput) -> (ProductPublic);
   createRecipe: (input: CreateRecipeInput) -> (Recipe);
   createTray: (input: CreateTrayInput) -> (TrayPublic);
   dabTransform: (record {
                    context: blob;
                    response: http_request_result;
                  }) -> (http_request_result) query;
   deletePost: (post_id: PostId) -> ();
   deleteProduct: (product_id: ProductId) -> ();
   deleteRecipe: (id: RecipeId) -> (bool);
   deleteTray: (tray_id: TrayId) -> ();
   delistNft: (tokenId: nat) -> (bool);
   delistPlant: (plantId: PlantId) -> (bool);
   editPost: (post_id: PostId, new_content: text) -> (PostPublic);
   ensureAdminProfile: () -> ();
   ensureCallerProfile: () -> ();
   feedEntireTray: (trayId: TrayId, productName: text, nutrientType: 
    text, dosage: text, notes: opt text) -> (nat);
   finalizeArtworkUpload: () -> (UploadResult);
   followUser: (target: principal) -> ();
   generateAllPoolNFTs: () -> (nat);
