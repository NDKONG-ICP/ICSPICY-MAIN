type FoundersMintResult = 
 record {
   recipient: principal;
   standard: NFTStandard;
   tokenId: text;
 };
type FoundersMintInput = 
 record {
   badgeImageKey: text;
   compositeImageKey: text;
   layerCombination: vec nat;
   nft_standard: NFTStandard;
   rarityTier: RarityTier;
   recipient: principal;
 };
type FeedingPublic = 
 record {
   date: Timestamp;
   dosage_amount: text;
   id: FeedingId;
   notes: opt text;
   nutrient_type: text;
   plant_id: PlantId;
   product_name: text;
 };
type FeedingId = nat;
type DeathCause = 
 variant {
   DampingOff;
   Disease;
   Drought;
   Other;
   Overwatering;
   PestDamage;
   Unknown;
 };
type DashboardStats = 
 record {
   germinatedToday: nat;
   lastWateredMsAgo: opt nat;
   needsAttention: nat;
   totalPlants: nat;
 };
type CreateTrayInput = 
 record {
   name: text;
   nft_standard: NFTStandard;
   planting_date: Timestamp;
 };
type CreateRecipeInput = 
 record {
   application_notes: text;
   description: text;
   full_name: text;
   ingredients: vec text;
   instructions: vec text;
   is_featured: bool;
   name: text;
   photo_key: opt text;
   shop_link: opt text;
   shop_link_label: opt text;
   tags: vec text;
 };
type CreateProposalInput = 
 record {
   description: text;
   ends_at: Timestamp;
   options: vec text;
   proposal_type: ProposalType;
   title: text;
 };
type CreateProductInput = 
 record {
   category: ProductCategory;
   description: text;
   image_key: opt text;
   image_keys: vec text;
   inventory_category: opt InventoryCategory;
   inventory_quantity: opt nat;
   name: text;
   plant_id: opt PlantId;
   price_cents: nat;
   price_per_unit_cents: opt nat;
   shippable: bool;
   shipping_flat_rate_cents: opt nat;
   unit_label: opt text;
   variety: opt text;
   weight_based: bool;
 };
type CreatePostInput = 
 record {
   anonymous: bool;
   content: text;
   image_key: opt text;
 };
type CreatePlantInput = 
 record {
   additional_notes: opt text;
   cell_position: nat;
   common_name: opt text;
   container_size: opt ContainerSize;
   date_purchased: opt Timestamp;
   genetics: text;
   latin_name: opt text;
   nft_standard: NFTStandard;
   notes: text;
   origin: opt text;
   pest_notes: opt text;
   planting_date: Timestamp;
   source_plant_id: opt PlantId;
   tray_id: TrayId;
   variety: text;
   watering_schedule: opt text;
 };
type CreateOrderInput = 
 record {
   items: vec OrderItem;
   pickup: bool;
   shipping: opt ShippingAddress;
 };
type CreateCommentInput = 
 record {
   content: text;
   post_id: PostId;
 };
type CounterOfferInput = 
 record {
   counter_amount: nat;
   counter_token: OfferToken;
   offer_id: text;
 };
type ContainerSize = 
 variant {
   Cell128;
   Cell72;
   Gal1;
   Gal10GrowBag;
   Gal15GrowBag;
   Gal1New;
   Gal3;
   Gal3New;
   Gal5;
   Gal5Bucket;
   Gal5GrowBag;
   Gal7GrowBag;
   Gal7Pot;
   InGround;
   Other: text;
   Oz16;
   Pot4Inch;
   Pot6Inch;
 };
type ConfirmOrderPaymentDirectResult = 
 record {
   claim_tokens: vec text;
   message: text;
   nft_token_ids: vec nat;
   success: bool;
 };
type CommentPublic = 
 record {
   author: principal;
   author_username: opt text;
   content: text;
   created_at: Timestamp;
   id: CommentId;
   post_id: PostId;
 };
type CommentId = nat;
type ClaimTokenId = text;
type CellStatus = 
 variant {
   Dead;
   Empty;
   Germinated;
   Planted;
   Transplanted;
 };
type CanisterTreasuryBalance = 
 record {
   balance: nat;
   ledgerCanisterId: text;
   symbol: text;
 };
type CallerDiscount = 
 record {
   discountPercent: nat;
   rarity: text;
   tokenId: opt nat;
 };
type BuyListedNftResult = 
 record {
   message: text;
   success: bool;
 };
type BulkCreateResult = 
 variant {
   err: text;
   ok: ProductPublic;
 };
type BatchGiftPackPublic = 
 record {
   claim_token_id: ClaimTokenId;
   created_at: Timestamp;
   creator: principal;
   highest_rarity_pct: nat;
   id: text;
   plant_ids: vec PlantId;
   redeemed: bool;
   redeemed_by: opt principal;
 };
type AuditEntry = 
 record {
   action: text;
   admin: principal;
   detail: text;
   ts: Time;
 };
type AssignAction = 
 variant {
   Airdrop: record {to: principal;};
   AssignToQR: record {claim_token: text;};
   ListOnShop: record {product_id: nat;};
 };
type ArtworkLayerId = nat;
type ArtworkLayer = 
 record {
   id: ArtworkLayerId;
   layer_number: nat;
   name: text;
   object_key: text;
   uploaded_at: Timestamp;
 };
type ApproveTokenResult = 
 variant {
   Err: ApproveTokenError;
   Ok: nat;
 };
type ApproveTokenError = 
 variant {
   CreatedInFuture: record {ledger_time: nat64;};
   Duplicate: record {duplicate_of: nat;};
   GenericBatchError: record {
                        error_code: nat;
                        message: text;
                      };
   GenericError: record {
                   error_code: nat;
                   message: text;
                 };
   InvalidSpender;
   NonExistingTokenId;
   TooOld;
   Unauthorized;
 };
type ApproveTokenArg = 
 record {
   approval_info: ApprovalInfo;
   token_id: nat;
 };
type ApprovalInfo = 
 record {
   created_at_time: opt nat64;
   expires_at: opt nat64;
   from_subaccount: opt blob;
   memo: opt blob;
   spender: Account;
 };
type AirdropAssignment = 
 record {
   nftId: nat;
   recipient: principal;
 };
type AdminWithdrawTokensResult = 
 record {
   blockIndex: opt nat;
   message: text;
   success: bool;
 };
type AddWeatherRecordInput = 
 record {
   date: text;
   humidity: opt float64;
   latitude: float64;
   longitude: float64;
   precipitation: float64;
   temperature_max: float64;
   temperature_min: float64;
   wind_speed: opt float64;
 };
type AddPlantResult = 
 record {
   claimToken: text;
   nftTokenId: nat;
   plantId: PlantId;
 };
type AddFeedingInput = 
 record {
   date: Timestamp;
   dosage_amount: text;
   notes: opt text;
   nutrient_type: text;
   plant_id: PlantId;
   product_name: text;
 };
type ActivityEntry = 
 record {
   actionType: text;
   author: principal;
   detail: text;
   plantId: PlantId;
   plantName: text;
   timestamp: Timestamp;
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt Subaccount;
 };
service : () -> ICSpicy
