   storeNimsPhotoFile: (path: text, data: vec nat8, mimeType: text) ->
    (StoredFile);
   submitOffer: (input: SubmitOfferInput) -> (Offer);
   toggleCooked: (plant_id: PlantId) -> ();
   toggleFavorite: (recipe_id: RecipeId) -> (bool);
   toggleRecipeFeatured: (id: RecipeId) -> (bool);
   transplantCell: (input: TransplantInput) -> (PlantPublic);
   transplantPlant: (plantId: PlantId, newContainer: ContainerSize,
    locationNotes: opt text) -> (bool);
   treasuryDeposit: (token: TreasuryToken, amount: nat, memo: opt text) ->
    (TreasuryTransaction);
   treasuryTransfer: (token: TreasuryToken, amount: nat, from: principal, to:
    principal, memo: opt text) -> (TreasuryTransaction);
   treasuryWithdraw: (token: TreasuryToken, amount: nat, to: principal, memo:
    opt text) -> (TreasuryTransaction);
   triggerLifecycleUpgrade: (plant_id: PlantId, new_stage: text) -> (text);
   unbanUser: (user: principal) -> ();
   unfollowUser: (target: principal) -> ();
   unlikePost: (post_id: PostId) -> (nat);
   updateCellData: (input: UpdateCellDataInput) -> ();
   updateNimsPlantStage: (plantId: PlantId, newStage: PlantStage) -> (bool);
   updateOrderStatus: (order_id: OrderId, status: OrderStatus) -> ();
   updateOrderStatusAdmin: (order_id: OrderId, status: OrderStatus) -> ();
   updatePlantMetadata: (input: UpdatePlantMetadataInput) -> ();
   updatePlantPrice: (plantId: PlantId, price: nat) -> (bool);
   updatePlantStage: (plant_id: PlantId, new_stage: PlantStage, notes:
    text) -> ();
   updatePlantingEvent: (input: UpdatePlantingEventInput) -> (PlantingEvent);
   updateProduct: (input: UpdateProductInput) -> ();
   updateProposal: (id: ProposalId, input: UpdateProposalInput) -> (bool);
   updateRecipe: (input: UpdateRecipeInput) -> (bool);
   updateSeedLot: (id: nat, quantity: opt nat, harvestDate: opt Timestamp,
    generation: opt text, germinationRate: opt nat, notes: opt text,
    isActive: opt bool, vendorId: opt nat) -> (bool);
   updateTrayName: (tray_id: TrayId, new_name: text) -> ();
   updateTrayOrder: (tray_id: TrayId, new_order: nat) -> ();
   updateVariety: (id: nat, name: opt text, species: opt text, scovilleMin:
    opt nat, scovilleMax: opt nat, description: opt text, imageUrl: opt text,
    daysToGerm: opt nat, daysToMature: opt nat) -> (bool);
   updateZoneNotes: (tray_id: TrayId, notes: text) -> ();
   uploadArtworkChunk: (chunkIndex: nat, totalChunks: nat, data: vec nat8) ->
    (variant {
       err: text;
       ok;
     });
   voteOnProposal: (proposal_id: ProposalId, option_index: nat) -> ();
   waterEntireTray: (trayId: TrayId, amountMl: nat, phLevel: opt float64,
    notes: opt text) -> (nat);
 };
