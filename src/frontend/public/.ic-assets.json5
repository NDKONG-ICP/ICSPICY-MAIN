[
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://icp-api.io https://*.icp0.io https://*.ic0.app https://identity.ic0.app https://identity.internetcomputer.org https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; connect-src 'self' https: wss: blob:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src https://identity.ic0.app https://identity.internetcomputer.org https://www.youtube-nocookie.com https://www.youtube.com https://www.paypal.com https://www.sandbox.paypal.com;"
    },
    "allow_raw_access": false
  },
  {
    "match": "assets/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  {
    "match": "**/index.html",
    "headers": {
      "Cache-Control": "public, max-age=300"
    }
  },
  {
    "match": "/404.html",
    "headers": {
      "Cache-Control": "public, max-age=3600"
    }
  },
  {
    "match": "**/*",
    "enable_aliasing": true
  }
]
