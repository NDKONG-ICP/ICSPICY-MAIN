[
  {
    "match": "**",
    "headers": "Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://icp-api.io https://*.icp0.io https://*.ic0.app https://identity.ic0.app https://identity.internetcomputer.org; connect-src 'self' https: wss: blob:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; frame-src https://identity.ic0.app https://identity.internetcomputer.org https://www.youtube-nocookie.com https://www.youtube.com;"
  },
  {
    "match": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)",
    "headers": "Cache-Control: public, max-age=31536000, immutable"
  },
  {
    "match": "**/*.@(js|css|xml)",
    "headers": "Cache-Control: public, max-age=86400"
  },
  {
    "match": "**/index.html",
    "headers": "Cache-Control: public, max-age=300"
  },
  {
    "match": "/404.html",
    "headers": "Cache-Control: public, max-age=3600"
  }
]
