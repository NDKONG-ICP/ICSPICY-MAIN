# IC SPICY — frontend environment variables
# Copy to .env.local and fill in real values. Never commit .env.local to git.

# ICPay publishable key (pk_ prefix — safe for client-side exposure)
# Sandbox:    get from betterstripe.com dashboard
# Production: get from icpay.org dashboard
VITE_ICPAY_PUBLISHABLE_KEY=pk_your_key_here

# ICPay API base URL
# Sandbox:    https://api.betterstripe.com
# Production: https://api.icpay.org  (default if unset)
VITE_ICPAY_API_BASE=https://api.icpay.org
