{
  "canisters": {
    "internet_identity": {
      "type": "custom",
      "candid": "vendor/internet-identity/internet_identity.did",
      "wasm": "vendor/internet-identity/internet_identity_dev.wasm.gz",
      "specified_id": "rdmx6-jaaaa-aaaaa-aaadq-cai"
    },
    "backend": {
      "type": "motoko",
      "main": "src/backend/main.mo",
      "args": "--actor-idl src/backend/system-idl",
      "wasm_memory_persistence": "keep"
    },
    "frontend": {
      "type": "assets",
      "source": ["src/frontend/dist"],
      "dependencies": ["backend"]
    },
    "nft_assets": {
      "type": "assets",
      "source": ["nft_assets_src"],
      "build": []
    },
    "uploads": {
      "type": "assets",
      "source": ["dist/uploads"],
      "build": []
    },
    "llm": {
      "type": "pull",
      "id": "w36hm-eqaaa-aaaal-qr76a-cai"
    },
    "docs_backend": {
      "type": "motoko",
      "main": "src/docs_backend/main.mo",
      "dependencies": ["llm"]
    },
    "docs_frontend": {
      "type": "assets",
      "source": ["src/docs_frontend/dist"],
      "dependencies": ["docs_backend", "spicy_ai_canister"]
    },
    "llama_cpp": {
      "type": "custom",
      "candid": "vendor/onicai/build/llama_cpp.did",
      "wasm": "vendor/onicai/build/llama_cpp.wasm"
    },
    "spicy_ai_canister": {
      "type": "motoko",
      "main": "src/spicy_ai_canister/main.mo",
      "wasm_memory_persistence": "keep"
    },
    "agent_hub": {
      "type": "motoko",
      "main": "src/agent_hub/main.mo",
      "wasm_memory_persistence": "keep"
    },
    "weather_mcp": {
      "type": "custom",
      "build": "bash scripts/build-weather-mcp.sh",
      "wasm": "src/weather_mcp/weather_mcp.wasm",
      "candid": "src/weather_mcp/weather_mcp.did",
      "metadata": [
        {
          "name": "candid:service",
          "path": "src/weather_mcp/weather_mcp.did"
        }
      ],
      "wasm_memory_persistence": "keep"
    },
    "weather_concierge_canister": {
      "type": "motoko",
      "main": "src/weather_concierge_canister/main.mo",
      "wasm_memory_persistence": "keep"
    },
    "weather_sentinel_canister": {
      "type": "motoko",
      "main": "src/weather_sentinel_canister/main.mo",
      "wasm_memory_persistence": "keep"
    },
    "fleet_cycles_ops_canister": {
      "type": "motoko",
      "main": "src/fleet_cycles_ops_canister/main.mo",
      "wasm_memory_persistence": "keep"
    },
    "newsletter_canister": {
      "type": "motoko",
      "main": "src/newsletter_canister/main.mo",
      "wasm_memory_persistence": "keep"
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    }
  },
  "version": 1
}
