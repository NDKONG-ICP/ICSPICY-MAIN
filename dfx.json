{
  "canisters": {
    "backend": {
      "type": "motoko",
      "main": "src/backend/main.mo",
      "args": "--actor-idl src/backend/system-idl"
    },
    "frontend": {
      "type": "assets",
      "source": ["src/frontend/dist"],
      "dependencies": ["backend"]
    },
    "nft_assets": {
      "type": "assets",
      "source": ["nft_assets_src"],
      "build": []
    },
    "llm": {
      "type": "pull",
      "id": "w36hm-eqaaa-aaaal-qr76a-cai"
    },
    "docs_backend": {
      "type": "motoko",
      "main": "src/docs_backend/main.mo",
      "dependencies": ["llm"]
    },
    "docs_frontend": {
      "type": "assets",
      "source": ["src/docs_frontend/dist"],
      "dependencies": ["docs_backend"]
    }
  },
  "defaults": {
    "build": {
      "packtool": "mops sources"
    }
  },
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    }
  },
  "version": 1
}
